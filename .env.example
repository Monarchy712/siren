# Siren live-mode configuration. Copy to .env and fill in; source before running.
# Each subsystem is INDEPENDENTLY switchable: unset -> that subsystem uses its
# stub; set -> live. Never commit real keys.

# --- The Graph (behavioral data) ------------------------------------------- #
# Live subgraph when set; else StubGraphClient.
SIREN_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<ID>/<slug>/version/latest
# SIREN_SUBGRAPH_API_KEY=            # only for the gateway URL, not Studio dev
# Wallet age is read from real on-chain first-seen (native+token):
SIREN_BASE_RPC_URL=https://sepolia.base.org
# SIREN_BASESCAN_API_KEY=            # optional; more accurate first-seen than RPC

# --- x402 payment gate (Blocky402 on Hedera testnet) ----------------------- #
# Live Blocky402Gate when SIREN_PAYTO_ACCOUNT is set; else StubX402Gate.
SIREN_PAYTO_ACCOUNT=0.0.xxxxxxx       # Hedera account that RECEIVES payment (Siren)
SIREN_PRICE_TINYBARS=1000000          # 0.01 HBAR per assessment (per-call only)
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
# SIREN_HEDERA_X402_NETWORK=hedera:testnet
# SIREN_X402_ASSET=0.0.0             # 0.0.0 = HBAR
# BLOCKY402_FEE_PAYER=               # pin facilitator feePayer; else from /supported
# BLOCKY402_API_KEY=                 # mainnet only; testnet needs none

# --- Hedera HCS (audit trail) ---------------------------------------------- #
# Live HederaHCSLogger when OPERATOR_ID + HCS_TOPIC_ID are set; else StubHCSLogger.
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=302e0201...       # DER or hex private key
HEDERA_HCS_TOPIC_ID=0.0.xxxxxxx       # create once: python scripts/create_hcs_topic.py
HEDERA_NETWORK=testnet
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# --- Client for the paid-call demo (scripts/pay_and_score.py) -------------- #
HEDERA_PAYER_ID=0.0.xxxxxxx           # funded testnet account that PAYS
HEDERA_PAYER_KEY=302e0201...
# SIREN_SCORE_URL=http://localhost:8000/score
