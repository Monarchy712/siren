# Copy to onchain/.env (gitignored) and fill in real values.
# seed.sh and verify.py read these; no real addresses live in committed source.

# Funder / deployer (the account that deployed the token and holds gas)
FUNDER=0xYOUR_FUNDER_ADDRESS

# Provider wallets (the three behavioral subjects)
EST=0xYOUR_ESTABLISHED_PROVIDER
SUS=0xYOUR_SUSPICIOUS_PROVIDER
NEW=0xYOUR_NEW_PROVIDER

# Disposable receive-only counterparties (generated locally)
E1=0xCOUNTERPARTY_1
E2=0xCOUNTERPARTY_2
E3=0xCOUNTERPARTY_3
E4=0xCOUNTERPARTY_4
E5=0xCOUNTERPARTY_5
E6=0xCOUNTERPARTY_6
S1=0xCOUNTERPARTY_7
S2=0xCOUNTERPARTY_8
N1=0xCOUNTERPARTY_9

# Deployed SirenTestToken address (verify.py may also take it as an arg)
TOKEN=0xYOUR_TOKEN_ADDRESS
